<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <noWarn>1591;NU1608</noWarn>
    <IsPackable>False</IsPackable>
    <OutputType>Library</OutputType>
    <!-- SkiaSharp native libraries shipped in the module package -->
    <SkiaSharpNativeRuntimes>linux-x64;linux-arm64;linux-musl-x64;osx;win-x64</SkiaSharpNativeRuntimes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Compile Remove="node_modules\**" />
    <EmbeddedResource Remove="dist\**" />
    <EmbeddedResource Remove="node_modules\**" />
    <None Remove="dist\**" />
    <None Remove="node_modules\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.ImageToolsModule.Core\VirtoCommerce.ImageToolsModule.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ImageToolsModule.Data\VirtoCommerce.ImageToolsModule.Data.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ImageToolsModule.Data.MySql\VirtoCommerce.ImageToolsModule.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ImageToolsModule.Data.PostgreSql\VirtoCommerce.ImageToolsModule.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ImageToolsModule.Data.SqlServer\VirtoCommerce.ImageToolsModule.Data.SqlServer.csproj" />
  </ItemGroup>
  <!-- Keep SkiaSharp native libraries only for $(SkiaSharpNativeRuntimes), without native debug symbols -->
  <Target Name="TrimSkiaSharpNativeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_SkiaSharpNativeAsset Include="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('SkiaSharp.NativeAssets'))" />
      <_SkiaSharpNativeAssetToKeep Include="@(_SkiaSharpNativeAsset)" Condition="'%(_SkiaSharpNativeAsset.Extension)' != '.pdb' and $([System.String]::Copy(';$(SkiaSharpNativeRuntimes);').Contains(';%(_SkiaSharpNativeAsset.RuntimeIdentifier);'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(_SkiaSharpNativeAsset)" />
      <RuntimeTargetsCopyLocalItems Include="@(_SkiaSharpNativeAssetToKeep)" />
    </ItemGroup>
    <!-- Never ship a package without the native library: thumbnails would fail at runtime -->
    <Error Condition="'@(_SkiaSharpNativeAsset)' != '' and '@(_SkiaSharpNativeAssetToKeep)' == ''" Text="No SkiaSharp native library matched SkiaSharpNativeRuntimes '$(SkiaSharpNativeRuntimes)'. Check the runtime identifiers and the RuntimeIdentifier metadata of RuntimeTargetsCopyLocalItems." />
  </Target>
  <ItemGroup>
    <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- NSwag emits repeated request/response plumbing; regenerate these clients instead of refactoring them.
         They stay project items so this project-level setting reaches them. -->
    <None Include="vue\src\api_client\virtocommerce.*.ts" />
    <SonarQubeSetting Include="sonar.cpd.exclusions">
      <Value>**/vue/src/api_client/virtocommerce.*.ts</Value>
    </SonarQubeSetting>
  </ItemGroup>
  <!-- Admin Shell plugin: built from vue/ into plugins/admin-shell/ before publish, so vc-build Compress (locally and in CI)
       packs it, as VirtoCommerce.SalesRep builds its storefront plugin. SkipAdminShellPlugin=true leaves it out. -->
  <Target Name="BuildAdminShellPlugin" BeforeTargets="Publish" Condition="'$(SkipAdminShellPlugin)' != 'true' AND Exists('$(MSBuildProjectDirectory)\vue\package.json')">
    <Exec Command="corepack enable" ContinueOnError="true" />
    <Exec Command="yarn install --immutable" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
    <Exec Command="yarn type-check" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
    <Exec Command="yarn build" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
  </Target>
  <!-- The platform probes {moduleRoot}/plugins/, but publish goes to {moduleRoot}/bin. The files are listed here, after the
       build: listed when the project loads, a clean checkout (no plugins/ yet) would copy nothing. -->
  <Target Name="CopyAdminShellPluginOnPublish" AfterTargets="Publish" DependsOnTargets="BuildAdminShellPlugin" Condition="'$(SkipAdminShellPlugin)' != 'true'">
    <ItemGroup>
      <AdminShellPlugin Include="$(MSBuildProjectDirectory)\plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\plugins\%(RecursiveDir)%(Filename)%(Extension)" />
  </Target>
</Project>
